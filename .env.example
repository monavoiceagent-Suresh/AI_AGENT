
# ============================================================
# APPLICATION
# ============================================================
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000
# Bearer token for the management API (/agents, /calls). Generate: python -c "import secrets; print(secrets.token_hex(32))"
APP_SECRET_KEY=replace_with_a_random_secret

# Public HTTPS URL reachable by Exotel (use an HTTPS tunnel such as ngrok or cloudflared locally).
# Used for the outbound StatusCallback; the Voicebot WebSocket URL is derived from it (see README).
PUBLIC_BASE_URL=https://your-public-tunnel.example

# ============================================================
# EXOTEL — TELEPHONY
# Dashboard > Settings > API Settings. API host by account region:
#   Singapore: https://api.exotel.com   India (Mumbai): https://api.in.exotel.com
# ============================================================
EXOTEL_ACCOUNT_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_API_BASE_URL=https://api.exotel.com
# Your ExoPhone, used as caller ID for outbound calls.
EXOTEL_CALLER_ID=
# App Bazaar > My Apps: ID of the flow containing the Voicebot applet (needed for outbound calls).
EXOTEL_APP_ID=
# Random secret placed in the StatusCallback URL. Exotel does not sign webhooks, so this token is
# what authenticates callbacks. Generate like APP_SECRET_KEY.
EXOTEL_WEBHOOK_SECRET=

ENABLE_INBOUND_CALLS=true
ENABLE_OUTBOUND_CALLS=false
MAX_CONCURRENT_CALLS=1
MAX_CALL_DURATION_SECONDS=1800

# Slots kept free for inbound calls. Outbound and campaign calls may use only
# MAX_CONCURRENT_CALLS - INBOUND_RESERVED_CALLS in total (0 = no reservation; cannot exceed MAX_CONCURRENT_CALLS).
INBOUND_RESERVED_CALLS=0
# Answer a dialled number that has no route published from the dashboard with the engine-wide default agent
# (is_inbound_default, no client_id). Set false once your numbers are routed: unrouted numbers are then refused.
INBOUND_LEGACY_DEFAULT_ENABLED=true
# Exotel's stream `to` is not always the ExoPhone that was dialled. When it matches no route, read Exotel's own record
# of the call (read-only, this account's credentials) and try the ExoPhone in it. A number that still matches nothing is
# refused (or answered by the default agent above). false = never contact Exotel's API at call time.
EXOTEL_RESOLVE_CALLED_NUMBER=true
EXOTEL_LOOKUP_TIMEOUT_SECONDS=3

# Campaigns started from the Mona dashboard. Must equal the dashboard's VOICE_ENGINE_WEBHOOK_SECRET:
# the engine signs each result it sends back with it. Without it, dispatches are rejected.
# Generate like APP_SECRET_KEY. Run one engine process only: it owns the campaign call queue.
DASHBOARD_WEBHOOK_SECRET=
# How often the dispatcher looks for the next call to place and for results to send (seconds).
DISPATCHER_POLL_SECONDS=2

# ============================================================
# ELEVENLABS — ASR (Scribe Realtime); also the optional TTS fallback
# The API key needs Speech-to-Text and Text-to-Speech access.
# ============================================================
ELEVENLABS_API_KEY=
ELEVENLABS_ASR_MODEL_ID=scribe_v2_realtime
# Used only when ElevenLabs is the TTS provider or the fallback. eleven_flash_v2_5 speaks en/hi/ta;
# Telugu needs eleven_v3.
ELEVENLABS_TTS_MODEL_ID=eleven_flash_v2_5
ELEVENLABS_TTS_VOICE_ID=
ELEVENLABS_TTS_STABILITY=0.5
ELEVENLABS_TTS_SIMILARITY_BOOST=0.75

# ============================================================
# TTS — Bakbak (Raya) is the primary provider
# ============================================================
# bakbak | elevenlabs
TTS_PROVIDER=bakbak
# Retry a sentence on ElevenLabs when Bakbak fails before producing any audio
# (needs ELEVENLABS_TTS_VOICE_ID; Flash v2.5 cannot speak Telugu, so Telugu has no fallback).
TTS_FALLBACK_ENABLED=false
BAKBAK_API_KEY=
BAKBAK_BASE_URL=https://hub.getraya.app/v1
# Voice and model per agent language. A voice belongs to ONE model and ONE language, and `m1` has only
# English and Hindi voices, so Tamil and Telugu use `standard`. List voices with:
#   curl -H "X-API-Key: $BAKBAK_API_KEY" https://hub.getraya.app/v1/voices
BAKBAK_VOICES={"en":{"voice_id":"","model_id":"m1"},"hi":{"voice_id":"","model_id":"m1"},"ta":{"voice_id":"","model_id":"standard"},"te":{"voice_id":"","model_id":"standard"}}

# ============================================================
# LLM — the primary is OpenRouter; Groq is the automatic fallback
# ============================================================
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# The old name OPENROUTER_FALLBACK_MODEL is still read if this one is not set.
OPENROUTER_MODEL=google/gemini-2.5-flash-lite
OPENROUTER_MAX_OUTPUT_TOKENS=250
OPENROUTER_TEMPERATURE=0.4
# A slow primary delays the caller's reply: after this timeout the fallback takes over. Each retry adds a full
# timeout before the fallback starts, so retries are off by default.
OPENROUTER_TIMEOUT_MS=4000
OPENROUTER_MAX_RETRIES=0

# Used when OpenRouter times out, drops the connection, is rate limited or errors before replying.
# Leave GROQ_API_KEY empty to use OpenRouter only.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-20b
# gpt-oss reasons before it answers and reasoning tokens count against this budget, so keep it generous.
GROQ_MAX_OUTPUT_TOKENS=1024
GROQ_TEMPERATURE=0.4
GROQ_TIMEOUT_MS=8000
GROQ_MAX_RETRIES=1

# ============================================================
# POSTGRESQL (docker compose)
# DATABASE_URL is used when the app runs on the host (uv run); the compose app
# service builds its own URL from POSTGRES_* pointing at the db container.
# ============================================================
POSTGRES_USER=voiceagent
POSTGRES_PASSWORD=change_me
POSTGRES_DB=voice_agent
# Host port for the db container (change if another PostgreSQL already uses 5432).
POSTGRES_HOST_PORT=5432
DATABASE_URL=postgresql://voiceagent:change_me@127.0.0.1:5432/voice_agent
DATABASE_POOL_MIN_SIZE=1
DATABASE_POOL_MAX_SIZE=5

# ============================================================
# CONVERSATION AND TURN MANAGEMENT
# ============================================================
# End the call after this long without caller speech.
SESSION_IDLE_TIMEOUT_SECONDS=120
# Caller silence that ends a turn (Scribe VAD commit; 192-3000 ms).
ENDPOINTING_MIN_SILENCE_MS=500
BARGE_IN_ENABLED=true
# Max agent audio queued ahead of playback at Exotel.
AUDIO_QUEUE_MAX_MS=2000
ASR_TIMEOUT_MS=5000
TTS_TIMEOUT_MS=5000

# ============================================================
# COST ESTIMATION (variable cost per call)
# ElevenLabs list prices: https://elevenlabs.io/pricing/api ; LLM cost comes from OpenRouter usage.
# Bakbak publishes no list price: set your contracted INR rate or TTS cost stays unpriced.
# ============================================================
USD_TO_INR=85.0
ELEVENLABS_ASR_USD_PER_HOUR=0.39
ELEVENLABS_TTS_USD_PER_1K_CHARS={"eleven_flash_v2_5":0.04,"eleven_multilingual_v2":0.08,"eleven_v3":0.08}
# Per-minute call rate from your Exotel plan; telephony is left out of the estimate when unset.
BAKBAK_INR_PER_1K_CHARS=0.3485
EXOTEL_INR_PER_MINUTE=0.6
TARGET_COST_PER_CONNECTED_MINUTE_INR=3.00

# ============================================================
# LOGGING
# ============================================================
# Log caller/agent utterances (contains personal data; keep false outside debugging).
LOG_TRANSCRIPTS=false
